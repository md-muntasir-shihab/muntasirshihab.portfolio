# ============================================================
# Portfolio Environment Variables (TEMPLATE)
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file — it is gitignored.
# ============================================================

# ---- Supabase (Database + Storage + Realtime) ----
# https://supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Server-only (NEVER prefix with VITE_):
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ---- Firebase (Auth + Analytics) ----
# https://console.firebase.google.com → Project Settings → Your apps
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR-PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR-PROJECT-ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR-PROJECT.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID

# ---- Upstash Redis (Rate Limiting + Caching) ----
# https://console.upstash.com → REST API
UPSTASH_REDIS_REST_URL=https://YOUR-DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_TOKEN

# ---- Resend (Email — contact form) ----
# https://resend.com → API Keys
RESEND_API_KEY=re_YOUR_RESEND_KEY
EMAIL_FROM=onboarding@resend.dev
EMAIL_TO=your@email.com

# ---- GitHub (Live stats / contributions) ----
# https://github.com/settings/tokens — Scopes: read:user, public_repo
VITE_GITHUB_USERNAME=yourgithubusername
GITHUB_TOKEN=ghp_YOUR_GITHUB_TOKEN

# ---- Site ----
VITE_SITE_URL=https://yourdomain.com
